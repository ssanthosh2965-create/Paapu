<!DOCTYPE html>
<html>
<head>
  <style>
    #splash {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: #030d28; 
      display: flex;
      justify-content: center;
      align-items: center;
      transition: opacity 1s;
    }

    #splash img {
      max-width: 80%;
      max-height: 80%;
    }

    .hide {
      opacity: 0;
      pointer-events: none;
    }
  </style>
</head>
<body>

  <div id="splash">
    <img src="logo.jpg" alt="MediFind Logo">
  </div>

  <h1>Welcome to MediFind</h1>
  <p>This is your home page content behind the splash screen.</p>

  <script>
    setTimeout(() => {
      document.getElementById('splash').classList.add('hide');
    }, 3000);
  </script>

</body>
</html>
